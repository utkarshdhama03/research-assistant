#!/usr/bin/env sh
# Back up the main database (pg_dump custom format) to data/backups/<db>-<UTC time>.dump.
# Usage, from the repo root: sh scripts/backup [--db NAME]
# Needs the compose stack's postgres service running. Honours COMPOSE_PROJECT_NAME.
set -eu
cd "$(dirname "$0")/.."

env_value() { # $1: key, $2: default. Reads .env (if any), ignoring comments and CR line endings.
    v=""
    [ -f .env ] && v=$(grep -E "^$1=" .env | tail -n 1 | cut -d= -f2- | tr -d '\r')
    printf '%s' "${v:-$2}"
}

PGUSER=$(env_value POSTGRES_USER research)
DB=$(env_value POSTGRES_DB research)
while [ $# -gt 0 ]; do
    case "$1" in
        --db) DB="$2"; shift 2 ;;
        -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

case "$DB" in
    ""|*[!A-Za-z0-9_]*) echo "database name must be letters, digits and _ only: $DB" >&2; exit 2 ;;
esac
mkdir -p data/backups
out="data/backups/$DB-$(date -u +%Y%m%d-%H%M%S).dump"
echo "backing up database $DB to $out"
if ! docker compose exec -T postgres pg_dump -U "$PGUSER" -d "$DB" --format=custom > "$out.partial"; then
    rm -f "$out.partial"
    echo "backup failed (is the postgres service running? docker compose ps)" >&2
    exit 1
fi
mv "$out.partial" "$out"
echo "done: $out ($(wc -c < "$out" | tr -d ' ') bytes)"
