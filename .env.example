# REQUIRED. A URL or mailto: where site operators can reach you. Used in the fetcher's
# User-Agent and by SearXNG (Wikimedia answers 403 without one). The app refuses to start
# while this is the placeholder below.
CONTACT_URL=mailto:you@example.com

# REQUIRED for Docker. The key you type on the login page (at least 32 characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_KEY=
# Login is on in Docker (compose sets AUTH_ENABLED=true unless you set it here) and off for
# `uv run ra serve` on the host. The API refuses to listen on a non-loopback address without it.
# AUTH_ENABLED=true
SESSION_TTL_H=12

# API and UI (http://127.0.0.1:API_PORT). In Docker the port is published on 127.0.0.1 only.
API_PORT=8000
# Extra Host header values to accept, with the port (JSON list), e.g. ["research.lan:8000"]
# API_ALLOWED_HOSTS=[]

# Postgres (docker compose). Set the password before the first `docker compose up`: it is fixed when
# the database volume is created. Letters and digits only (it is part of DATABASE_URL).
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_TEST_DB=research_test
POSTGRES_PORT=5434

# App database URLs (must match the values above)
DATABASE_URL=postgresql+psycopg://research:research@127.0.0.1:5434/research
TEST_DATABASE_URL=postgresql+psycopg://research:research@127.0.0.1:5434/research_test

# Ollama (native on the host, not in Docker). OLLAMA_URL is for running on the host; containers use
# OLLAMA_URL_DOCKER (default http://host.docker.internal:11434).
OLLAMA_URL=http://localhost:11434
# OLLAMA_URL_DOCKER=http://host.docker.internal:11434
CHAT_MODEL=qwen3:8b
VERIFY_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# One context window for all roles (changing it per request reloads the model)
OLLAMA_NUM_CTX=6144
# Server-side Ollama settings: set these as user environment variables, then restart Ollama.
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
LLM_TIMEOUT_S=120
LLM_KEEP_ALIVE=30m
LLM_MAX_REPAIRS=2
LLM_RETRIES=3
LLM_BACKOFF_S=2.0
# Calibrated against qwen3:8b prompt_eval_count (measured 3.78-4.58); used by the context guard
LLM_CHARS_PER_TOKEN=3.7

# SearXNG (docker compose)
SEARXNG_PORT=8888
SEARXNG_URL=http://localhost:8888
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
SEARCH_TIMEOUT_S=15
SEARCH_RETRIES=2
SEARCH_BACKOFF_S=0.5
# ddgs fallback, used only when SearXNG errors or returns no results
SEARCH_FALLBACK_ENABLED=true

# Fetcher (User-Agent is "ResearchAssistant/0.1 (+<CONTACT_URL>)")
FETCH_TIMEOUT_S=20
FETCH_HOST_MIN_DELAY_S=1.0
ROBOTS_MAX_BYTES=512000

# Extract, chunk, embed
EXTRACT_MIN_CHARS=300
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP=0.15
CHARS_PER_TOKEN=4
EMBED_BATCH_SIZE=32
EMBED_RETRIES=2

# Budgets
# 3-5, the bounds of the plan schema
MAX_SUB_QUESTIONS=5
MAX_SOURCES_PER_QUERY=5
# Picks per sub-question (select schema bound), fetches per run, chunks kept per source
MAX_SOURCES_PER_SUB_QUESTION=3
MAX_SOURCES_PER_RUN=15
MAX_CHUNKS_PER_SOURCE=40
# Run wall-clock budget; research stops starting new work at this share of it
RUN_DEADLINE_S=1800
RESEARCH_BUDGET_SHARE=0.7
# Chunks retrieved run-wide per report section
WRITE_TOP_K=6
PLAN_NUM_PREDICT=700
SELECT_NUM_PREDICT=150
WRITE_NUM_PREDICT=900
# Claims and verification
MAX_BACKFILLS_PER_SUB_QUESTION=2
QUERY_JACCARD_THRESHOLD=0.6
ANALYZE_TOP_K=6
MAX_CLAIMS_PER_SUB_QUESTION=6
MIN_SUPPORTED_CLAIMS=2
CLAIM_DEDUPE_THRESHOLD=0.96
VERIFY_BUDGET_SHARE=0.9
ANALYZE_NUM_PREDICT=900
VERIFY_NUM_PREDICT=300
GAP_NUM_PREDICT=150
# JSON list; a written sentence with one of these phrases not found in its cited claims is replaced by the claims
SPECULATION_PHRASES=["may have", "might have", "could have", "likely", "possibly", "potentially", "perhaps", "suggests that", "contributing to", "which may", "which could"]
MAX_FETCH_BYTES=5000000
MAX_GAP_LOOPS=1
NODE_TIMEOUT_S=600
